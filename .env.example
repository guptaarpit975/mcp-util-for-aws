OPSLENS_ENVIRONMENT=development
OPSLENS_HOST=127.0.0.1
OPSLENS_PORT=8000
OPSLENS_FRONTEND_ORIGIN=http://127.0.0.1:5173
OPSLENS_DATABASE_URL=mysql+asyncmy://opslens:opslens@127.0.0.1:3307/opslens
OPSLENS_AUTO_CREATE_SCHEMA=false
OPSLENS_DEFAULT_AWS_PROFILE=
OPSLENS_DEFAULT_AWS_REGIONS=ap-south-1,us-east-1
OPSLENS_MCP_TOOL_TIMEOUT_SECONDS=30
OPSLENS_INVENTORY_PAGE_LIMIT=10
OPSLENS_MAX_AGENT_ITERATIONS=6
OPSLENS_MAX_TOOL_RESULT_CHARS=50000
OPSLENS_MODEL_MAX_TOKENS=2048

# Optional fallback. Prefer storing the key through Settings -> Model provider.
# ANTHROPIC_API_KEY=
